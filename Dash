    dcc.Markdown(' Jezrel Hernandez Alvarado - A01340173 y María Fernanda San Román Orozco - A01424691',
                 style={'textAlign': 'center', 'color': '#5E7A91', 'marginBottom': '24px'}),

    html.Div(
        dcc.Dropdown(
            id='dropdown-grafico',
            options=GRAFICOS,
            value='g1',
            clearable=False,
            style={'width': '420px'}
        ),
        style={'display': 'flex', 'justifyContent': 'center', 'marginBottom': '16px'}
    ),

    dcc.Graph(id='grafico'),

    dcc.Markdown(id='descripcion',
                 style={'maxWidth': '860px', 'margin': '16px auto',
                        'color': '#2A475E', 'lineHeight': '1.7'}),

], style={'fontFamily': 'sans-serif', 'padding': '32px'})


@app.callback(
    Output('grafico',     'figure'),
    Output('descripcion', 'children'),
    Input('dropdown-grafico', 'value')
)
def actualizar(value):
    return make_figure(value), DESCRIPCIONES[value]


if __name__ == '__main__':
    app.run(debug=True)